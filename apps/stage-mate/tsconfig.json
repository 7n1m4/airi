{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "harness/**/*"
  ],
  // NOTICE: root tsconfig.json excludes bare "apps"/"apps/**"; in a child config those entries
  // resolve against this child's own directory, i.e. <root>/apps, which is an ancestor of
  // harness/**/* here and therefore emptied the entire include set (TS18003).
  // A child-level exclude fully REPLACES the inherited one, so restate the only entries that
  // matter locally.
  "exclude": [
    "dist",
    "node_modules"
  ]
}
