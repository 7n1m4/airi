{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "target": "ESNext",
    "jsx": "preserve",
    "lib": [
      "ESNext"
    ],
    "useDefineForClassFields": true,
    "baseUrl": ".",
    "paths": {
      "@proj-airi/i18n-bundle": [
        "../../packages/i18n/src/dist-lite/messages.mjs"
      ],
      "@proj-airi/server-runtime": [
        "../../packages/server-runtime/src"
      ],
      "electrobun": [
        "./.hutch/devkit/api/sdks/main/index.ts"
      ],
      "electrobun/main": [
        "./.hutch/devkit/api/sdks/main/index.ts"
      ],
      "electrobun/view": [
        "./.hutch/devkit/api/browser/index.ts"
      ],
      "electron": [
        "./src/main/electron-shim.ts"
      ],
      "electron/*": [
        "./src/main/electron-shim.ts"
      ]
    },
    "resolveJsonModule": true,
    "types": [
      "vitest",
      "vite/client",
      "unplugin-info/client",
      "node"
    ],
    "allowJs": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "src/env.d.ts",
    "../../uno.config.ts",
    "uno.config.ts",
    "electrobun.config.ts",
    "hutch.config.ts",
    "vite.config.ts",
    "src/main/**/*.ts",
    "src/main/**/*.d.ts",
    "src/main/**/*.tsx",
    "src/main/**/*.vue",

    "src/shared/**/*.ts",
    "src/shared/**/*.d.ts",
    "src/shared/**/*.tsx",
    "src/shared/**/*.vue"
  ],
  // NOTICE: root tsconfig.json excludes bare "apps"/"apps/**"; in a child config those
  // entries resolve against this child's own directory, i.e. <root>/apps, which is an
  // ancestor of the sources included here and therefore excludes this app's own files.
  // A child-level exclude fully REPLACES the inherited one, so restate the only entries
  // that matter locally.
  "exclude": [
    "node_modules",
    "dist"
  ]
}
