# Use "pglite://" for the embedded PGlite zero-dependency path; any other DSN is a real Postgres.
DATABASE_URL="postgresql://postgres:change-me@db:5432/postgres"

BETTER_AUTH_SECRET="change-me-generate-a-long-random-string"

AUTH_GOOGLE_CLIENT_ID="change-me"
AUTH_GOOGLE_CLIENT_SECRET="change-me"

AUTH_GITHUB_CLIENT_ID="change-me"
AUTH_GITHUB_CLIENT_SECRET="change-me"

