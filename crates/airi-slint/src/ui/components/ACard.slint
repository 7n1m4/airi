// Themed card surface. Port of qml/components/ACard.qml: a bordered rounded
// panel with inner padding. Children go in the default slot and are laid out
// by a vertical box; callers needing free-form layout set `padded: false`
// and place children directly (Slint has no QML `anchors.fill`).

import { Theme } from "../Theme.slint";

export component ACard inherits Rectangle {
    in property <length> padding: Theme.spacing-l;
    in property <color> fill: Theme.surface;
    in property <color> border-color: Theme.border;
    in property <bool> padded: true;

    border-radius: Theme.radius-l;
    border-width: 1px;
    background: root.fill;
    border-color: root.border-color;

    body := VerticalLayout {
        padding: root.padded ? root.padding : 0px;
        @children
    }
}