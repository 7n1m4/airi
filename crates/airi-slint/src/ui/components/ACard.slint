// Themed card surface: a bordered rounded panel with inner padding. Children
// go in the default slot and are laid out by a vertical box; callers needing
// free-form layout set `padded: false` and place children directly.

import { Theme } from "../Theme.slint";

export component ACard inherits Rectangle {
    in property <length> inner-padding: Theme.spacing-l;
    in property <color> fill: Theme.surface;
    in property <color> stroke: Theme.border;
    in property <bool> padded: true;

    border-radius: Theme.radius-l;
    border-width: 1px;
    background: root.fill;
    border-color: root.stroke;

    body := VerticalLayout {
        padding: root.padded ? root.inner-padding : 0px;
        @children
    }
}