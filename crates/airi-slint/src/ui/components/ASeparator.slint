// Hairline separator: "horizontal" (default) draws a 1px-high rule,
// "vertical" a 1px-wide rule. The preferred-size is 100x1 / 1x100 so
// layouts that ask for a fill get a sane default.

import { Theme } from "../Theme.slint";

export component ASeparator inherits Rectangle {
    in property <string> orientation: "horizontal";

    preferred-width: root.orientation == "vertical" ? 1px : 100px;
    preferred-height: root.orientation == "vertical" ? 100px : 1px;
    background: Theme.border;
}