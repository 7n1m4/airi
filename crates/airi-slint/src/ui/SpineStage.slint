//
// Spine stage: hosts the native spine rasterized frame and drives it through
// the SpineController bridge (idle loop, emotions, poke gesture). A demo
// animation ("idle") plays automatically after loadModel.
//
// Consumers (stage window) are expected to host this component, e.g.:
//   SpineStage { width: 640px; height: 640px; }
// The render itself is produced by the Rust spine_render rasterizer; this
// component only displays the resulting image and exposes the control API.

export component SpineStage inherits Rectangle {
    in property <string> model_path;
    in property <float> render_scale: 1.0;
    in property <int> max_fps: 0;
    in property <float> offset_x: 0.0;
    in property <float> offset_y: 0.0;
    in property <bool> loaded: false;
    in property <bool> playing: false;
    in property <image> frame;

    callback load_model(string);
    callback play(string, bool);
    callback poke();

    background: #0b0d12;
    clip: true;

    Image {
        source: root.frame;
        width: 100%;
        height: 100%;
        image-fit: contain;
    }
}