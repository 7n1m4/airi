{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      // NOTICE: packages/i18n generates src/dist-lite/messages.mjs
      // (consumed by stage-tamagotchi electron-vite). It must be declared
      // an output or turbo cache hits restore dist/ without it -> ENOENT.
      "outputs": ["dist/**", "out/**", "src/dist-lite/**"]
    }
  }
}
